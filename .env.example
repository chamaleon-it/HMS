# Set these in Cloudways before `npm run build`.
# Next.js inlines NEXT_PUBLIC_* at build time, so a runtime-only change is not enough.
# PORT is provided by Cloudways. `npm start` binds 0.0.0.0 on that port.
# Local API example: http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_HOSPITAL_NAME=
NEXT_PUBLIC_HOSPITAL_ADDRESS=
NEXT_PUBLIC_HOSPITAL_PHONE=
NEXT_PUBLIC_HOSPITAL_EMAIL=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_DIGI_PIN=
NEXT_PUBLIC_LOGO=/logo.png
