# Copy this file to frontend/.env.
# NEXT_PUBLIC_* values are visible in the browser. Do not put secrets here.

# API origin used for requests and uploaded files.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
# Default URL for callers that create their own API client.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Details displayed on bills, reports, and printed documents.
NEXT_PUBLIC_HOSPITAL_NAME="Your Hospital"
NEXT_PUBLIC_HOSPITAL_ADDRESS="123 Main Street, City"
NEXT_PUBLIC_HOSPITAL_PHONE="+91 00000 00000"
NEXT_PUBLIC_HOSPITAL_EMAIL=contact@example.com
NEXT_PUBLIC_LOGO=/logo.png
NEXT_PUBLIC_GSTIN=
# Optional location identifier.
NEXT_PUBLIC_DIGI_PIN=

# Optional: use an existing dev server when launching Electron.
# ELECTRON_START_URL=http://localhost:3000
